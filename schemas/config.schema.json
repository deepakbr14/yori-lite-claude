{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yori Lite single Cortex config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin_id",
    "active_cortex"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plugin_id": {
      "const": "yori_2d970fa0-89e4-451e-802b-9f836f99d9e1"
    },
    "active_cortex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "google_drive_folder_id"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "google_drive_folder_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "google_sheets_spreadsheet_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "legacy_graph_spreadsheet_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "storage_format": {
      "type": "string",
      "enum": [
        "metadata-v1",
        "mixed-v1-v2",
        "docs-v2",
        "sheets-graph-v1",
        "sheets-log-v1"
      ]
    },
    "cortex_schema_version": {
      "const": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "storage_format"
        ],
        "properties": {
          "storage_format": {
            "const": "sheets-graph-v1"
          }
        }
      },
      "then": {
        "required": [
          "cortex_schema_version"
        ],
        "properties": {
          "active_cortex": {
            "required": [
              "google_sheets_spreadsheet_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "storage_format"
        ],
        "properties": {
          "storage_format": {
            "const": "sheets-log-v1"
          }
        }
      },
      "then": {
        "required": [
          "cortex_schema_version"
        ],
        "properties": {
          "active_cortex": {
            "required": [
              "google_sheets_spreadsheet_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "active_cortex": {
            "required": [
              "legacy_graph_spreadsheet_id"
            ]
          }
        }
      },
      "then": {
        "required": [
          "storage_format"
        ],
        "properties": {
          "storage_format": {
            "const": "sheets-log-v1"
          }
        }
      }
    }
  ]
}
