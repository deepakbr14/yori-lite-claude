        "properties": {
          "edge_id": {
            "type": "string"
          },
          "revision_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "from_node_id": {
            "type": "string"
          },
          "to_node_id": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "strength": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "contributor": {
            "type": "string"
          },
          "attribution": {
            "enum": [
              "explicit_statement",
              "external_evidence",
              "inference",
              "decision",
              "mixed",
              "unknown"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "base_revision_ids": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ]
          }
        }
      },
      "x-column-order": [
        "edge_id",
        "revision_id",
        "operation_id",
        "from_node_id",
        "to_node_id",
        "relation",
        "strength",
        "evidence",
        "contributor",
        "attribution",
        "created_at",
        "base_revision_ids",
        "version",
        "status"
      ]
    },
    "History": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "operation_id",
          "event_type",
          "entity_id",
          "content",
          "contributor",
          "attribution",
          "source",
          "recorded_at",
