{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yori Lite graph workbook staging format",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Nodes",
    "Edges",
    "History",
    "Directory",
    "Metadata"
  ],
  "properties": {
    "Nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "revision_id",
          "operation_id",
          "kind",
          "title",
          "content",
          "subject",
          "contributor",
          "attribution",
          "source",
          "created_at",
          "updated_at",
          "event_time",
          "base_revision_ids",
          "version",
          "status"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "revision_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "contributor": {
            "type": "string"
          },
          "attribution": {
            "enum": [
              "explicit_statement",
              "external_evidence",
              "inference",
              "decision",
              "mixed",
              "unknown"
            ]
          },
          "source": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "event_time": {
            "type": "string"
          },
          "base_revision_ids": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ]
          }
        }
      },
      "x-column-order": [
        "node_id",
        "revision_id",
        "operation_id",
        "kind",
        "title",
        "content",
        "subject",
        "contributor",
        "attribution",
        "source",
        "created_at",
        "updated_at",
        "event_time",
        "base_revision_ids",
        "version",
        "status"
      ]
    },
    "Edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "revision_id",
          "operation_id",
          "from_node_id",
          "to_node_id",
          "relation",
          "strength",
          "evidence",
          "contributor",
          "attribution",
          "created_at",
          "base_revision_ids",
          "version",
          "status"
