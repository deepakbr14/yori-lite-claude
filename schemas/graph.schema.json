          "entity_id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "contributor": {
            "type": "string"
          },
          "attribution": {
            "enum": [
              "explicit_statement",
              "external_evidence",
              "inference",
              "decision",
              "mixed",
              "unknown"
            ]
          },
          "source": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string"
          },
          "base_revision_ids": {
            "type": "string"
          },
          "manifest": {
            "type": "string"
          }
        }
      },
      "x-column-order": [
        "event_id",
        "operation_id",
        "event_type",
        "entity_id",
        "content",
        "contributor",
        "attribution",
        "source",
        "recorded_at",
        "base_revision_ids",
        "manifest"
      ]
    },
    "Directory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hint_id",
          "node_id",
          "revision_id",
          "row_number",
          "operation_id",
          "verified_at"
        ],
        "properties": {
          "hint_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "revision_id": {
            "type": "string"
          },
          "row_number": {
            "type": "integer",
            "minimum": 2
          },
          "operation_id": {
            "type": "string"
          },
          "verified_at": {
            "type": "string"
          }
        }
